 {"name":"E1 default arm anchor REMOVED",
  "edits":[["    default: {                                      /* 2328 bytes -- own anchor in this arm */\n        volatile CdrEnv *d = &_cdr;\n        __asm__(\"\" : \"=r\"(d) : \"0\"(d));\n        d->w10 = 0x246;\n        break;\n    }\n",
            "    default: *(int *)&g->w10 = 0x246; break;\n"]]},

 {"name":"E2 default sz named first",
  "edits":[["        volatile CdrEnv *d = &_cdr;\n        __asm__(\"\" : \"=r\"(d) : \"0\"(d));\n        d->w10 = 0x246;",
            "        int sz = 0x246;\n        volatile CdrEnv *d = &_cdr;\n        __asm__(\"\" : \"=r\"(d) : \"0\"(d));\n        d->w10 = sz;"]]},

 {"name":"E3 default sz named+fenced",
  "edits":[["        volatile CdrEnv *d = &_cdr;\n        __asm__(\"\" : \"=r\"(d) : \"0\"(d));\n        d->w10 = 0x246;",
            "        int sz = 0x246;\n        volatile CdrEnv *d;\n        __asm__(\"\" : \"=r\"(sz) : \"0\"(sz));\n        d = &_cdr;\n        __asm__(\"\" : \"=r\"(d) : \"0\"(d));\n        d->w10 = sz;"]]},

 {"name":"E4 void fence head of case 0x20",
  "edits":[["    case 0x20: *(int *)&g->w10 = 0x249; break;",
            "    case 0x20: __asm__(\"\" : : \"i\"(0)); *(int *)&g->w10 = 0x249; break;"]]},

 {"name":"E5 default nonvol store",
