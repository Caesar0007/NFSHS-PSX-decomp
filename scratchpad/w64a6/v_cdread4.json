[
 {"name":"J1 w00 nonvol + void barrier before it",
  "edits":[["    e->w04 = (u_char *)buf;\n    e->w00 = sectors;",
            "    e->w04 = (u_char *)buf;\n    __asm__(\"\" : : \"i\"(0));\n    *(int *)&e->w00 = sectors;"]]},
 {"name":"J2 w00 nonvol + barrier before w04 too",
  "edits":[["    e->w04 = (u_char *)buf;\n    e->w00 = sectors;",
            "    __asm__(\"\" : : \"i\"(0));\n    e->w04 = (u_char *)buf;\n    __asm__(\"\" : : \"i\"(0));\n    *(int *)&e->w00 = sectors;"]]},
 {"name":"J3 both nonvol + barrier between",
  "edits":[["    e->w04 = (u_char *)buf;\n    e->w00 = sectors;",
            "    *(u_char **)&e->w04 = (u_char *)buf;\n    __asm__(\"\" : : \"i\"(0));\n    *(int *)&e->w00 = sectors;"]]},
 {"name":"J4 w00 nonvol via separate ptr",
  "edits":[["    e->w04 = (u_char *)buf;\n    e->w00 = sectors;",
            "    e->w04 = (u_char *)buf;\n    *(int *)((char *)e + 0) = sectors;"]]},
 {"name":"K1 slt: named bool + read-only fence",
  "edits":[["    return _read_issue(0) > 0;",
            "    { int r = _read_issue(0) > 0; __asm__(\"\" : : \"r\"(r)); return r; }"]]},
 {"name":"K2 slt: named bool + identity fence",
  "edits":[["    return _read_issue(0) > 0;",
            "    { int r = _read_issue(0) > 0; __asm__(\"\" : \"=r\"(r) : \"0\"(r)); return r; }"]]},
 {"name":"K3 slt: named call result + void fence",
  "edits":[["    return _read_issue(0) > 0;",
            "    { int r = _read_issue(0); __asm__(\"\" : : \"i\"(0)); return r > 0; }"]]},
 {"name":"K4 J1+K1",
  "edits":[["    e->w04 = (u_char *)buf;\n    e->w00 = sectors;",
            "    e->w04 = (u_char *)buf;\n    __asm__(\"\" : : \"i\"(0));\n    *(int *)&e->w00 = sectors;"],
           ["    return _read_issue(0) > 0;",
            "    { int r = _read_issue(0) > 0; __asm__(\"\" : : \"r\"(r)); return r; }"]]}
